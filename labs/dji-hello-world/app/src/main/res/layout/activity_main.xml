<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="20sp"
        android:text="Starting…" />

    <com.example.djihellodrone.LogPanel
        android:id="@+id/logPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="#ECEFF1" />

    <CheckBox
        android:id="@+id/simulatorCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simulator (props off, nothing really flies)" />

    <CheckBox
        android:id="@+id/lightsCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:checked="true"
        android:text="Drone lights on (untick to test switching them off)" />

    <!-- Says in words why the mission buttons are grey, or that they are ready. -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/mission1Button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/mission_button_bg"
        android:textColor="@color/mission_button_text"
        android:textSize="18sp"
        android:text="🚁  Mission 1 (demo)" />

    <Button
        android:id="@+id/mission2Button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/mission_button_bg"
        android:textColor="@color/mission_button_text"
        android:textSize="18sp"
        android:text="❤️  Mission 2 (light painting)" />

    <Button
        android:id="@+id/mission3Button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/mission_button_bg"
        android:textColor="@color/mission_button_text"
        android:textSize="18sp"
        android:text="⭐  Mission 3 (star or triangle)" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:backgroundTint="#C62828"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:text="■  STOP + LAND" />
</LinearLayout>
